    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@wokcito/ffmpeg-kit-react-native",
          "expo-av",
          "react-native-cashfree-pg-sdk",
          "react-native-color-matrix-image-filters",
          "react-native-vector-icons"
