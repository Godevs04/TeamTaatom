{
  "name": "taatom",
  "version": "26.4.01",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "update-config": "node scripts/update-app-json.js",
    "prestart": "npm run update-config",
    "verify-build": "node scripts/verify-build.js",
    "prebuild": "npm run update-config && npm run verify-build",
    "postinstall": "node scripts/patch-ffmpeg-kit-podspec.js && node scripts/patch-ffmpeg-kit-android.js && node scripts/patch-react-native-maps.js && node scripts/patch-expo-av-ios.js && node scripts/update-app-json.js",
    "build:web": "expo export --platform web --output-dir dist --source-maps",
    "build:analyze": "node scripts/analyze-bundle.js",
    "postbuild:web": "npm run build:analyze",
    "upload-sourcemaps": "node scripts/upload-sourcemaps.js",
    "lint": "tsc --noEmit && echo \"TS OK\"",
    "lint:full": "npm run lint && npx expo-doctor"
  },
  "dependencies": {
